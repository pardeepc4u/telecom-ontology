# Copy to .env and fill in to match your Phase 1 home-lab stack.
# .env is gitignored — never commit real credentials.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tickets

# vLLM OpenAI-compatible endpoint(s)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_EMBEDDING_MODEL=
VLLM_API_KEY=EMPTY

# Chat-capable model for Phase 4's router + entity/intent extraction.
# Point VLLM_BASE_URL at a different server if embeddings and chat aren't
# served from the same vLLM instance.
VLLM_CHAT_MODEL=
